{{- if eq .packageMode "homebrew" }}
#!/bin/bash
set -euo pipefail

find_brew() {
    local brew_path

    brew_path="$(command -v brew 2>/dev/null || true)"
    if [[ -n "$brew_path" && -x "$brew_path" ]]; then
        printf '%s\n' "$brew_path"
        return 0
    fi

    for brew_path in \
        /opt/homebrew/bin/brew \
        /usr/local/bin/brew \
        /home/linuxbrew/.linuxbrew/bin/brew
    do
        if [[ -x "$brew_path" ]]; then
            printf '%s\n' "$brew_path"
            return 0
        fi
    done

    return 1
}

if brew_path="$(find_brew)"; then
    printf 'Homebrew is already installed at %s\n' "$brew_path"
    exit 0
fi

case "$(uname -s)" in
    Darwin|Linux) ;;
    *)
        printf 'Homebrew installation is not supported on this operating system.\n' >&2
        exit 1
        ;;
esac

if [[ ! -x /bin/bash ]]; then
    printf 'Homebrew installation requires /bin/bash.\n' >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    printf 'Homebrew installation requires curl.\n' >&2
    exit 1
fi

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

if ! brew_path="$(find_brew)"; then
    printf 'Homebrew installation completed, but brew was not found.\n' >&2
    exit 1
fi

"$brew_path" --version
{{- end }}
