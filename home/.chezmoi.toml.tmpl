{{- $workMachine := promptBoolOnce . "workMachine" "Is this a work machine" false -}}
{{- $guiDefault := or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
{{- $gui := promptBoolOnce . "gui" "Does this machine have a graphical desktop" $guiDefault -}}
{{- $gitName := promptStringOnce . "gitName" "What name should Git use" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "What email address should Git use" -}}

{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $wsl = contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{- end -}}

{{- $packageChoices := list "none" -}}
{{- $packageDefault := "none" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $packageChoices = list "homebrew" "none" -}}
{{-   $packageDefault = "homebrew" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $packageChoices = list "homebrew" "native" "none" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $packageChoices = list "winget" "none" -}}
{{-   $packageDefault = "winget" -}}
{{- end -}}
{{- $packageMode := promptChoiceOnce . "packageMode" "How should packages be managed" $packageChoices $packageDefault -}}

{{ if eq .chezmoi.os "windows" -}}
# WinGet installs pwsh later; setup scripts must support built-in PowerShell 5.1.
[interpreters.ps1]
command = "powershell.exe"
# Skip profiles during setup. Bypass is process-only; Group Policy still applies.
args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]

{{ end -}}
[data]
workMachine = {{ $workMachine }}
gui = {{ $gui }}
packageMode = {{ $packageMode | quote }}
wsl = {{ $wsl }}
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}
